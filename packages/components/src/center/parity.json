      "differences": [
        {
          "id": "CENTER-01",
          "type": "approved-api-difference",
          "text": "isInline is the `inline` boolean attribute (drop `is`, A§7.2)."
        },
        {
          "id": "CENTER-02",
          "type": "approved-api-difference",
          "text": "The host carries the sizes and an inner part=\"base\" flex box centres and pads the content, so a percentage size resolves against the parent and padding survives an application reset. The host resets the private box custom properties, which would otherwise inherit into a nested centre."
        }
