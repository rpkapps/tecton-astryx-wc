      "hooks": [],
      "keyboard": [],
      "form": {
        "formAssociated": false
      },
      "differences": [
        {
          "id": "SECTION-01",
          "type": "approved-api-difference",
          "text": "The two-div structure is kept: the host carries the sizes, an internal wrapper cancels the padding of an enclosing padded container (it reads the --container-padding-* the container publishes, so it has to be an ancestor of the element that publishes this section's own), and part=\"base\" paints. First and last child escape the block padding through :host(:first-child) and :host(:last-child)."
        },
        {
          "id": "SECTION-02",
          "type": "approved-api-difference",
          "text": "The padding custom properties (`--card-padding*` / `--section-padding*`) are the WC form of the documented themed padding (`derived: padding, expand: container`); private steps propagate through --_section-padding-propagated."
        },
        {
          "id": "SECTION-03",
          "type": "tecton-visual",
          "text": "Surface, muted and transparent fills come from --color-background-surface and --color-background-muted; dividers are one border-width in --color-border (tecton-astryx components.ts: section is not a theme target)."
        },
        {
          "id": "SECTION-04",
          "type": "a11y-improvement",
          "text": "Divider borders are repainted with ButtonBorder in forced-colors mode."
        }
      ],
      "tests": {
        "render": true,
        "a11y": true,
        "api": true,
        "keyboard": false,
        "form": false,
        "events": true,
        "rtl": true,
        "forcedColors": true,
