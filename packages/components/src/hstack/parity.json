          "default": false
        },
        {
          "upstream": "width",
          "kind": "prop",
          "target": "width",
          "as": "attribute"
        },
        {
          "upstream": "height",
          "kind": "prop",
          "target": "height",
          "as": "attribute"
        },
        {
          "upstream": "maxWidth",
          "kind": "prop",
          "target": "max-width",
          "as": "attribute"
        },
        {
          "upstream": "minHeight",
          "kind": "prop",
          "target": "min-height",
          "as": "attribute"
        },
        {
          "upstream": "hAlign",
          "kind": "prop",
          "target": "h-align",
          "as": "attribute",
          "notes": "Main axis of a horizontal stack (start, center, end, between, around, evenly)."
        },
        {
          "upstream": "vAlign",
          "kind": "prop",
          "target": "v-align",
          "as": "attribute",
          "notes": "Cross axis (start, center, end, stretch); stretch is the flex default."
        },
        {
          "upstream": "justify",
          "kind": "prop",
          "target": "justify",
          "as": "attribute"
        },
        {
          "upstream": "align",
          "kind": "prop",
          "target": "alignment",
          "as": "attribute",
          "notes": "Renamed: `align` attribute has presentational meaning in browsers (A\u00a77.2)."
        },
        {
          "upstream": "wrap",
          "kind": "prop",
          "target": "wrap",
          "as": "attribute",
          "reflect": true,
          "default": "nowrap"
        },
        {
          "upstream": "as",
          "kind": "prop",
          "target": "as",
          "as": "attribute",
          "default": "div"
        },
        {
          "upstream": "children",
          "kind": "slot",
          "target": "default",
          "as": "slot"
        },
        {
          "upstream": "xstyle",
          "kind": "prop",
          "as": "waived",
          "reason": "A-xstyle: use class/style on the host, ::part(base), or the padding/gap attributes."
        },
        {
          "upstream": "ref",
          "kind": "ref",
          "as": "waived",
          "reason": "The element itself is the handle; the flex box is reachable as part \"base\"."
        }
