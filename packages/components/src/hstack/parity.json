      "differences": [
        {
          "id": "HSTACK-01",
          "type": "approved-api-difference",
          "text": "Subclass of tct-stack with the direction fixed: the inherited `direction` attribute is ignored and reset to horizontal (upstream omits the prop from the HStack type)."
        },
        {
          "id": "HSTACK-02",
          "type": "approved-api-difference",
          "text": "`align` is the `alignment` attribute (see STACK-01); the other differences of tct-stack (STACK-02..05) apply."
        }
      ],
      "tests": {
        "render": true,
        "a11y": true,
        "api": true,
        "keyboard": false,
        "form": false,
        "events": true,
