---
/** Header facts of a generated component page: tag(s), status, category, upstream mapping. */
interface Props {
  tags: string[];
  status: string;
  category: string;
  upstream: string[];
  provisional?: number;
}

const {tags, status, category, upstream, provisional = 0} = Astro.props;
const tone = status === 'verified' || status === 'implemented' ? 'success' : 'warning';
---

<ul class="tct-meta not-content" aria-label="Component facts">
  {tags.map((tag) => <li><code>{`<${tag}>`}</code></li>)}
  <li><span class="tct-badge" data-tone={tone}>{status}</span></li>
  <li><span class="tct-badge">{category}</span></li>
  {upstream.length > 0 && <li><span class="tct-badge">Astryx: {upstream.join(', ')}</span></li>}
  {provisional > 0 && <li><span class="tct-badge" data-tone="warning">{provisional} provisional</span></li>}
</ul>
