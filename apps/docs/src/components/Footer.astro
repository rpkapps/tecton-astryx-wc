---
/**
 * Page footer (overrides Starlight's Footer): the default footer plus a link to the third-party
 * notices page, which carries the licence notice that adapted material requires (D-015).
 */
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Default {...Astro.props}><slot /></Default>
<p class="tct-legal"><a href={`${base}/legal/third-party-notices/`}>Third-party notices</a></p>

<style>
  .tct-legal {
    margin-block-start: 1.5rem;
    font-size: var(--sl-text-sm);
  }
</style>
