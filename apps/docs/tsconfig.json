{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@examples/*": ["../../packages/components/src/*"]
    },
    "customConditions": ["tct-source"],
    "allowImportingTsExtensions": true,
    "types": ["node"]
  }
}
